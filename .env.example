# Copy this file to .env.local and fill in real values for local development.
# In Vercel, set the same names under Project Settings -> Environment Variables.

# --- Firebase client config -------------------------------------------------
# Firebase Console -> Project settings -> General -> "Your apps" -> Web app
# -> SDK setup and configuration -> Config. Create the web app first if you
# haven't (the "</>" icon on the project overview page).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Web Push (VAPID) --------------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
# The public key is safe to expose to the client; the private key is server-only.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Contact URI web-push sends to push services, e.g. mailto:you@example.com
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com

# --- Server-to-server auth for the push-sending API route ------------------
# Any random long string; same value the (future) cron job sends as the
# `x-cron-secret` header when calling POST /api/push/send.
CRON_SECRET=
